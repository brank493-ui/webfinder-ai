// ===========================================
// WEBFINDER AI - PRODUCTION BACKEND SCHEMA
// PostgreSQL + Redis + WebSocket Ready
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// AUTH & USER MANAGEMENT
// ===========================================

enum UserRole {
  OWNER
  ADMIN
  DEVELOPER
  SALES
  CLIENT
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String
  surname               String?
  passwordHash          String?
  role                  UserRole  @default(CLIENT)
  provider              String    @default("credential") // 'credential', 'google'
  avatar                String?
  phone                 String?
  gender                String?
  country               String?
  city                  String?
  credentialNumber      String?   @unique // User's unique credential number for login
  emailVerified         Boolean   @default(false)
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  sessions              Session[]
  refreshTokens         RefreshToken[]
  projects              Workspace[]
  teamMemberships       TeamMember[]
  notifications         Notification[]
  activities            ActivityLog[]
  messages              WorkspaceMessage[]

  @@index([email])
  @@index([credentialNumber])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ===========================================
// DISCOVER MODULE - LEADS & CONVERSATIONS
// ===========================================

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  DECLINED
}

model Lead {
  id              String        @id @default(uuid())
  businessName    String
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  category        String?
  website         String?
  placeId         String?       @unique // Google Places ID
  latitude        Float?
  longitude       Float?
  rating          Float?
  reviewCount     Int?
  
  // Lead tracking
  source          String        @default("discover") // 'discover', 'manual', 'referral'
  status          LeadStatus    @default(NEW)
  priority        String        @default("medium") // 'high', 'medium', 'low'
  leadScore       Int?          // 0-100
  
  // Conversion tracking
  convertedAt     DateTime?
  workspaceId     String?
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id])
  
  // Relations
  conversations   Conversation[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([source])
  @@index([priority])
  @@index([category])
}

model Conversation {
  id          String        @id @default(uuid())
  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  // AI conversation
  messages    String        // JSON array of conversation messages
  brief       String?       // JSON object of collected requirements
  
  // Status
  status      String        @default("active") // 'active', 'completed', 'declined'
  lastMessageAt DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([leadId])
  @@index([status])
}

// ===========================================
// WORKSPACES MODULE - PROJECT MANAGEMENT
// ===========================================

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

model Workspace {
  id              String          @id @default(uuid())
  
  // Client info
  clientId        String
  client          User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessName    String
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  category        String?
  
  // Project details
  package         String          @default("standard") // 'standard', 'pro', 'premium'
  status          ProjectStatus   @default(PENDING)
  progress        Int             @default(0) // 0-100
  
  // Brief (structured JSON)
  brief           String?         // Full brief JSON
  
  // Design preferences
  designStyle     String?
  primaryColor    String?
  secondaryColor  String?
  pages           String?         // JSON array of pages
  features        String?         // JSON array of features
  
  // Domain & deployment
  domain          String?
  websiteUrl      String?
  
  // Payment
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentMethod   String?
  amount          Float?
  currency        String          @default("USD")
  
  // Relations
  messages        WorkspaceMessage[]
  files           WorkspaceFile[]
  deployments     Deployment[]
  activities      ActivityLog[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([package])
}

model WorkspaceMessage {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  attachments   String?   // JSON array of file URLs
  read          Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([senderId])
  @@index([read])
}

model WorkspaceFile {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  url           String
  type          String    // 'preview', 'asset', 'document'
  size          Int?
  uploadedBy    String?
  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([type])
}

// ===========================================
// TOOLS MODULE
// ===========================================

// Domains
model Domain {
  id            String    @id @default(uuid())
  name          String    @unique
  status        String    @default("pending") // 'pending', 'active', 'expired', 'transferred'
  workspaceId   String?
  registrar     String?
  purchaseDate  DateTime?
  expiryDate    DateTime?
  autoRenew     Boolean   @default(true)
  sslEnabled    Boolean   @default(false)
  dnsRecords    String?   // JSON array
  nameservers   String?   // JSON array
  price         Float?
  currency      String    @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([workspaceId])
}

// Email Campaigns
model EmailCampaign {
  id              String    @id @default(uuid())
  name            String
  subject         String
  content         String    // HTML content
  templateId      String?
  status          String    @default("draft") // 'draft', 'scheduled', 'sending', 'sent', 'cancelled'
  scheduledAt     DateTime?
  sentAt          DateTime?
  recipientCount  Int       @default(0)
  openCount       Int       @default(0)
  clickCount      Int       @default(0)
  openRate        Float?
  clickRate       Float?
  metadata        String?   // JSON
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model EmailTemplate {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  subject     String
  content     String    // HTML with variables
  category    String    // 'outreach', 'followup', 'promo', 'welcome'
  variables   String    // JSON array
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
}

// Analytics
model MonthlyAnalytics {
  id                String    @id @default(uuid())
  month             String    @unique // '2024-01'
  year              Int
  totalRevenue      Float     @default(0)
  totalProjects     Int       @default(0)
  completedProjects Int       @default(0)
  newLeads          Int       @default(0)
  convertedLeads    Int       @default(0)
  conversionRate    Float?
  websiteVisitors   Int       @default(0)
  pageViews         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([month])
  @@index([year])
}

model AnalyticsEvent {
  id          String    @id @default(uuid())
  workspaceId String?
  eventType   String    // 'page_view', 'click', 'conversion', 'email_open'
  page        String?
  referrer    String?
  userAgent   String?
  ipAddress   String?
  country     String?
  city        String?
  metadata    String?   // JSON
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

// ===========================================
// ENTERPRISE MODULE
// ===========================================

model Team {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  plan        String       @default("free") // 'free', 'pro', 'enterprise'
  members     TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([plan])
}

model TeamMember {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("member") // 'owner', 'admin', 'developer', 'sales', 'viewer'
  status      String   @default("pending") // 'active', 'pending', 'inactive'
  lastActive  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

// Billing
model Invoice {
  id           String    @id @default(uuid())
  number       String    @unique
  workspaceId  String?
  clientName   String
  clientEmail  String
  projectName  String
  amount       Float
  currency     String    @default("USD")
  status       String    @default("draft") // 'draft', 'sent', 'paid', 'overdue', 'cancelled'
  issueDate    DateTime  @default(now())
  dueDate      DateTime
  paidDate     DateTime?
  items        String    // JSON array
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([workspaceId])
  @@index([dueDate])
}

model Payment {
  id            String    @id @default(uuid())
  workspaceId   String?
  provider      String    // 'stripe', 'orange_money', 'mtn_money', 'wave', 'bank'
  transactionId String?
  phoneNumber   String?
  amount        Float
  currency      String
  status        String    @default("pending") // 'pending', 'processing', 'completed', 'failed'
  metadata      String?   // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([provider])
}

// Deployments
model Deployment {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectName     String
  domain          String
  status          String    @default("pending") // 'building', 'deploying', 'live', 'failed', 'paused'
  framework       String    @default("nextjs")
  region          String    @default("us-east")
  buildTime       Int?      // seconds
  sslEnabled      Boolean   @default(false)
  cdnEnabled      Boolean   @default(false)
  lastDeployed    DateTime?
  buildLogs       String?   // JSON
  envVars         String?   // JSON
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([domain])
}

// Website Editor
model WebsiteEditor {
  id          String    @id @default(uuid())
  workspaceId String    @unique
  blocks      String    // JSON array of editor blocks
  version     Int       @default(1)
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

// ===========================================
// ONBOARDING MODULE
// ===========================================

model AccessCode {
  id          String    @id @default(uuid())
  code        String    @unique
  email       String?
  workspaceId String?
  package     String?   // Package assigned
  used        Boolean   @default(false)
  usedBy      String?   // User ID
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([used])
}

model Package {
  id          String    @id @default(uuid())
  name        String    @unique // 'standard', 'pro', 'premium'
  displayName String
  price       Float
  currency    String    @default("USD")
  priceCFA    Int?
  features    String    // JSON array
  isPopular   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

// ===========================================
// NOTIFICATIONS & ACTIVITY
// ===========================================

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // 'message', 'payment', 'project', 'lead', 'system'
  title       String
  description String
  read        Boolean   @default(false)
  actionUrl   String?
  actionLabel String?
  metadata    String?   // JSON
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  type        String    // 'user', 'payment', 'ai_agent', 'website', 'message', 'system'
  action      String    // 'created', 'updated', 'deleted', 'completed'
  title       String
  description String
  metadata    String?   // JSON
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

// ===========================================
// BACKGROUND JOBS QUEUE (BullMQ)
// ===========================================

model JobQueue {
  id          String    @id @default(uuid())
  jobType     String    // 'search_businesses', 'send_email', 'deploy'
  status      String    @default("pending") // 'pending', 'processing', 'completed', 'failed'
  data        String    // JSON
  result      String?   // JSON
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([scheduledAt])
}

// ===========================================
// SYSTEM SETTINGS
// ===========================================

model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
}
