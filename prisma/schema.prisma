// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// User model for client authentication
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  surname               String?
  passwordHash          String?
  role                  String    @default("user") // 'owner', 'user'
  provider              String    @default("credential") // 'credential', 'google'
  avatar                String?
  phone                 String?
  gender                String?   // 'male', 'female', 'other'
  country               String?
  city                  String?
  hasCompletedOnboarding Boolean  @default(false)
  projectId             String?
  credentialNumber      String?   @unique // User's unique credential number for login
  emailVerified         Boolean   @default(false)
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions              Session[]
  projects              UserProject[]

  @@index([email])
  @@index([credentialNumber])
  @@index([role])
}

// Session model for persistent login
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?  // Browser/Device info
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// User projects
model UserProject {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String?
  websiteType     String?
  services        String?  // JSON array
  domain          String?
  designStyle     String?
  primaryColor    String?
  secondaryColor  String?
  features        String?  // JSON array
  pages           String?  // JSON array
  additionalInfo  String?
  package         String?  // 'standard', 'pro', 'premium'
  status          String   @default("draft") // 'draft', 'pending', 'in_progress', 'completed'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}

// Access codes for inviting new clients
model AccessCode {
  id          String   @id @default(cuid())
  code        String   @unique
  email       String?
  projectId   String?
  used        Boolean  @default(false)
  usedBy      String?  // User ID who used this code
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([used])
}

// Messages between users and admin
model Message {
  id          String   @id @default(cuid())
  projectId   String
  senderId    String   // User ID or 'admin'
  senderName  String
  content     String
  isFromAdmin Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([senderId])
  @@index([read])
}

model Business {
  id             String         @id @default(cuid())
  placeId        String?        @unique
  name           String
  email          String?
  address        String?
  phone          String?
  website        String?
  category       String?
  rating         Float?
  reviewCount    Int?
  latitude       Float?
  longitude      Float?
  hasWebsite     Boolean        @default(false)
  websiteStatus  String?        // 'no_website', 'active', 'broken', 'social_media'
  photoUrl       String?
  country        String?
  city           String?
  conversations  Conversation[]
  projects       Project[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([hasWebsite])
  @@index([category])
  @@index([country])
}

model Conversation {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     String   @default("active") // 'active', 'completed', 'declined'
  messages   String   // JSON array of messages
  brief      String?  // JSON object of collected requirements
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([status])
}

model Project {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  package         String   @default("standard") // 'standard', 'pro', 'premium'
  status          String   @default("pending") // 'pending', 'in_progress', 'review', 'completed', 'cancelled'
  brief           String?  // JSON object of requirements
  paymentStatus   String   @default("pending") // 'pending', 'paid', 'refunded'
  paymentMethod   String?  // 'stripe', 'orange_money', 'mtn_money', 'wave', 'mpesa'
  stripePaymentId String?
  amount          Float?
  currency        String   @default("USD")
  websiteUrl      String?  // Final website URL
  notes           String?  // Admin notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([paymentStatus])
  @@index([package])
}

model WebsiteTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String?  // Restaurant, Retail, Health, etc.
  previewUrl  String?
  features    String   // JSON array of features
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPremium])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  projectId     String
  provider      String   // 'stripe', 'orange_money', 'mtn_money', 'wave', 'mpesa'
  transactionId String?
  phoneNumber   String?
  amount        Float
  currency      String
  status        String   @default("pending") // 'pending', 'processing', 'completed', 'failed'
  metadata      String?  // JSON for additional data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([provider])
}

model Domain {
  id           String   @id @default(cuid())
  name         String   @unique
  status       String   @default("pending") // 'pending', 'active', 'expired', 'transferred'
  projectId    String?
  registrar    String?  // 'namecheap', 'godaddy', 'google'
  purchaseDate DateTime?
  expiryDate   DateTime?
  autoRenew    Boolean  @default(true)
  sslEnabled   Boolean  @default(false)
  dnsRecords   String?  // JSON array of DNS records
  nameservers  String?  // JSON array of nameservers
  price        Float?
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([projectId])
}

model EmailCampaign {
  id           String   @id @default(cuid())
  name         String
  subject      String
  content      String   // HTML content
  templateId   String?
  status       String   @default("draft") // 'draft', 'scheduled', 'sending', 'sent', 'cancelled'
  scheduledAt  DateTime?
  sentAt       DateTime?
  recipientCount Int    @default(0)
  openCount    Int      @default(0)
  clickCount   Int      @default(0)
  openRate     Float?
  clickRate    Float?
  metadata     String?  // JSON for additional data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([templateId])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  subject     String
  content     String   // HTML content with variables
  category    String   // 'outreach', 'followup', 'promo', 'welcome'
  variables   String   // JSON array of available variables
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  projectId   String?
  eventType   String   // 'page_view', 'click', 'conversion', 'email_open', etc.
  page        String?
  referrer    String?
  userAgent   String?
  ipAddress   String?
  country     String?
  city        String?
  metadata    String?  // JSON for additional data
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([eventType])
  @@index([createdAt])
}

model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  language     String   @default("en")
  theme        String   @default("system") // 'light', 'dark', 'system'
  notifications Boolean @default(true)
  emailUpdates Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Phase 4 - Enterprise & Automation Models

model Team {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  plan        String     @default("free") // 'free', 'pro', 'enterprise'
  members     TeamMember[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([plan])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  email     String
  role      String   @default("member") // 'owner', 'admin', 'developer', 'sales', 'viewer'
  status    String   @default("pending") // 'active', 'pending', 'inactive'
  avatar    String?
  lastActive DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@index([status])
}

model Invoice {
  id           String   @id @default(cuid())
  number       String   @unique
  projectId    String?
  clientName   String
  clientEmail  String
  projectName  String
  amount       Float
  currency     String   @default("USD")
  status       String   @default("draft") // 'draft', 'sent', 'paid', 'overdue', 'cancelled'
  issueDate    DateTime @default(now())
  dueDate      DateTime
  paidDate     DateTime?
  items        String   // JSON array of invoice items
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([projectId])
  @@index([dueDate])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'message', 'payment', 'project', 'alert', 'system'
  title       String
  description String
  read        Boolean  @default(false)
  actionUrl   String?
  actionLabel String?
  metadata    String?  // JSON for additional data
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
}

model Deployment {
  id            String   @id @default(cuid())
  projectId     String
  projectName   String
  domain        String
  status        String   @default("pending") // 'building', 'deploying', 'live', 'failed', 'paused'
  framework     String   @default("nextjs")
  region        String   @default("us-east")
  buildTime     Int?     // in seconds
  sslEnabled    Boolean  @default(false)
  cdnEnabled    Boolean  @default(false)
  analyticsEnabled Boolean @default(false)
  lastDeployed  DateTime?
  buildLogs     String?  // JSON array of build logs
  envVars       String?  // JSON object of environment variables
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([domain])
}

model WebsiteEditor {
  id          String   @id @default(cuid())
  projectId   String   @unique
  blocks      String   // JSON array of editor blocks
  version     Int      @default(1)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}
